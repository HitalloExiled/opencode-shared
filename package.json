  "type": "module",
  "description": "Shared SolidJS GUI kit for the OpenCode plugins (side panels, scroll navigation, states, i18n, panel registration).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HitalloExiled/opencode-shared.git"
  },
